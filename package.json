{
  "name": "ishaan-vats-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "prestart": "node scripts/check-env.mjs",
    "setup:local": "node scripts/init-local.mjs",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "node scripts/database-command.mjs migrate",
    "db:migration": "node scripts/database-command.mjs migrate:create",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "node scripts/patch-payload-style.mjs",
    "predev": "node scripts/patch-payload-style.mjs",
    "prebuild": "node scripts/patch-payload-style.mjs",
    "setup:neon": "node scripts/init-neon.mjs",
    "db:status": "node scripts/database-command.mjs migrate:status"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-s3": "^3.92.0",
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "payload": "3.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sass": "1.105.2",
    "dompurify": "3.4.17"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
