# Copy to .env. Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Neon direct URL (no -pooler in the host), including sslmode=require.
DATABASE_URL=
# Same branch/database, with connection pooling enabled, for CMS requests.
DATABASE_URL_POOLED=
# Optional legacy override for migrations. Leave blank with the Neon names above.
DATABASE_URL_DIRECT=
# Cloud databases always use migrations; no automatic schema push.
DATABASE_PUSH=false
# Optional, only while provisioning Neon; never needed by the running portfolio.
NEON_API_KEY=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# true only for the first local setup. Disable before exposing the server.
ALLOW_FIRST_USER=true
# Required for production media; keep bucket private and use Payload's access-controlled URLs.
S3_BUCKET=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Existing S3_REGION / S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY aliases also work.
# Optional public CDN origin, only for a bucket intentionally configured for public media.
S3_PUBLIC_URL=
